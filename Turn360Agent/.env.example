# Turn360 Agent local configuration template.
# Copy to .env for local use, then fill keys locally.
# Do not commit real secrets.

# LLM provider selection:
# - none: disable LLM and use deterministic fallback
# - deepseek: DeepSeek OpenAI-compatible chat completions
# - openai: OpenAI Responses API
# - openai_compatible: later MiniMax/GLM-style compatible providers
LLM_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1200

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest
OPENAI_TIMEOUT_SECONDS=20

# Generic OpenAI-compatible provider, reserved for MiniMax/GLM/etc.
LLM_PROVIDER_NAME=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

